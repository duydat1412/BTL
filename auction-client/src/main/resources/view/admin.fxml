<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.AdminController"
      prefHeight="768.0" prefWidth="1024.0"
      styleClass="canvas">

    <!-- Navbar -->
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="nav-bar">
        <Label text="🏛 DHDH SYSTEM MANAGEMENT" styleClass="text-lg, font-bold, text-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="userInfoLabel" styleClass="text-sm, text-body"/>
        <Button text="Đăng xuất 🚪" onAction="#handleLogout" styleClass="btn-secondary" style="-fx-min-height: 36px; -fx-padding: 6px 16px;"/>
    </HBox>

    <TabPane VBox.vgrow="ALWAYS" styleClass="tab-pane" style="-fx-padding: 20;">
        <!-- Tab 1: Dashboard -->
        <Tab text="📊 Dashboard Tổng quan" closable="false">
            <VBox spacing="25" alignment="TOP_CENTER" style="-fx-padding: 20 0 20 0;">
                <Label text="Số Liệu Thống Kê Hệ Thống" styleClass="text-2xl, font-bold, text-white"/>

                <HBox spacing="20" maxWidth="960" HBox.hgrow="ALWAYS">
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="👤 TỔNG NGƯỜI DÙNG" styleClass="text-xs, text-body" style="-fx-font-weight: bold;"/>
                        <Label fx:id="totalUsersLabel" text="0" styleClass="text-3xl, font-bold, text-white"/>
                    </VBox>
                    <VBox spacing="8" styleClass="stat-card, stat-card-primary" HBox.hgrow="ALWAYS">
                        <Label text="💼 SỐ LƯỢNG SELLER" styleClass="text-xs, text-primary" style="-fx-font-weight: bold;"/>
                        <Label fx:id="totalSellersLabel" text="0" styleClass="text-3xl, font-bold, text-primary"/>
                    </VBox>
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="🔨 SỐ LƯỢNG BIDDER" styleClass="text-xs, text-body" style="-fx-font-weight: bold;"/>
                        <Label fx:id="totalBiddersLabel" text="0" styleClass="text-3xl, font-bold, text-white"/>
                    </VBox>
                </HBox>

                <HBox spacing="20" maxWidth="960" HBox.hgrow="ALWAYS">
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="📦 TỔNG SỐ ITEM" styleClass="text-xs, text-body" style="-fx-font-weight: bold;"/>
                        <Label fx:id="totalItemsLabel" text="0" styleClass="text-3xl, font-bold, text-white"/>
                    </VBox>
                    <VBox spacing="8" styleClass="stat-card, stat-card-primary" HBox.hgrow="ALWAYS">
                        <Label text="⚡ ĐẤU GIÁ ĐANG CHẠY" styleClass="text-xs, text-primary" style="-fx-font-weight: bold;"/>
                        <Label fx:id="activeAuctionsLabel" text="0" styleClass="text-3xl, font-bold, text-primary"/>
                    </VBox>
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="🏁 ĐẤU GIÁ KẾT THÚC" styleClass="text-xs, text-body" style="-fx-font-weight: bold;"/>
                        <Label fx:id="finishedAuctionsLabel" text="0" styleClass="text-3xl, font-bold, text-warning" style="-fx-text-fill: -accent-yellow;"/>
                    </VBox>
                </HBox>

                <Label fx:id="dashboardStatus" styleClass="status-info, text-sm"/>
            </VBox>
        </Tab>

        <!-- Tab 2: User Management -->
        <Tab text="👥 Quản lý người dùng" closable="false">
            <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="2">
                        <Label text="Quản lý thông tin &amp; Trạng thái tài khoản" styleClass="text-lg, font-bold, text-white"/>
                        <Label text="Kích hoạt hoặc khóa người dùng, theo dõi số dư trong thời gian thực" styleClass="text-xs, text-body"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Làm mới danh sách 🔄" onAction="#handleRefreshUsers" styleClass="btn-secondary" style="-fx-min-height: 38px; -fx-padding: 8px 16px;"/>
                </HBox>
                <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="usernameCol" text="Username" prefWidth="150"/>
                        <TableColumn fx:id="emailCol" text="Email" prefWidth="250"/>
                        <TableColumn fx:id="roleCol" text="Vai trò" prefWidth="100"/>
                        <TableColumn fx:id="statusCol" text="Trạng thái" prefWidth="120"/>
                        <TableColumn fx:id="balanceCol" text="Số dư (VNĐ)" prefWidth="150"/>
                        <TableColumn fx:id="actionCol" text="Thao tác hành động" prefWidth="200"/>
                    </columns>
                </TableView>
                <Label fx:id="userStatus" styleClass="status-info, text-sm"/>
            </VBox>
        </Tab>

        <!-- Tab 3: Auction Management -->
        <Tab text="⚙ Quản lý phiên đấu giá" closable="false">
            <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="2">
                        <Label text="Quản lý và Giám sát các phiên đấu" styleClass="text-lg, font-bold, text-white"/>
                        <Label text="Xem trạng thái đấu giá, kết quả chung cuộc, hủy phiên đấu khi cần thiết" styleClass="text-xs, text-body"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Làm mới danh sách 🔄" onAction="#handleRefreshAuctions" styleClass="btn-secondary" style="-fx-min-height: 38px; -fx-padding: 8px 16px;"/>
                </HBox>
                <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="auctionTitleCol" text="Tiêu đề sản phẩm" prefWidth="300"/>
                        <TableColumn fx:id="auctionStatusCol" text="Trạng thái đấu" prefWidth="150"/>
                        <TableColumn fx:id="auctionPriceCol" text="Giá hiện tại (VNĐ)" prefWidth="180"/>
                        <TableColumn fx:id="auctionEndCol" text="Thời điểm kết thúc" prefWidth="200"/>
                        <TableColumn fx:id="auctionActionCol" text="Thao tác" prefWidth="150"/>
                    </columns>
                </TableView>
                <Label fx:id="auctionStatus" styleClass="status-info, text-sm"/>
            </VBox>
        </Tab>
    </TabPane>

</VBox>
