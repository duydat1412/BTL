<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.SellerDashboardController"
      prefHeight="768.0" prefWidth="1024.0"
      styleClass="canvas">

    <!-- Navbar -->
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="nav-bar">
        <Label text="🏛 DHDH SELLER HUB" styleClass="text-lg, font-bold, text-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="userInfoLabel" styleClass="text-sm, text-body"/>
        <Label fx:id="balanceLabel" styleClass="text-sm, font-mono, text-white" style="-fx-font-weight: bold;"/>
        <Button text="Nạp tiền 💰" onAction="#handleTopUp" styleClass="btn-secondary" style="-fx-min-height: 36px; -fx-padding: 6px 16px;"/>
        <Button text="Đăng xuất 🚪" onAction="#handleLogout" styleClass="btn-secondary" style="-fx-min-height: 36px; -fx-padding: 6px 16px;"/>
    </HBox>

    <VBox spacing="20" alignment="TOP_CENTER" VBox.vgrow="ALWAYS" styleClass="section">
        <padding><Insets top="20" bottom="20" left="30" right="30"/></padding>

        <!-- Metric Analytics Cards -->
        <HBox spacing="20" maxWidth="960" HBox.hgrow="ALWAYS">
            <VBox fx:id="cardTotal" spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="📦 TỔNG SẢN PHẨM" styleClass="text-xs, text-body" style="-fx-font-weight: bold;"/>
                <Label fx:id="totalItemsLabel" text="0" styleClass="text-2xl, font-bold, text-white"/>
            </VBox>
            <VBox fx:id="cardActive" spacing="8" styleClass="stat-card, stat-card-primary" HBox.hgrow="ALWAYS">
                <Label text="⚡ ĐANG ĐẤU GIÁ" styleClass="text-xs, text-primary" style="-fx-font-weight: bold;"/>
                <Label fx:id="activeAuctionsLabel" text="0" styleClass="text-2xl, font-bold, text-primary"/>
            </VBox>
            <VBox fx:id="cardFinished" spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="🏁 PHIÊN KẾT THÚC" styleClass="text-xs, text-body" style="-fx-font-weight: bold;"/>
                <Label fx:id="finishedAuctionsLabel" text="0" styleClass="text-2xl, font-bold, text-white"/>
            </VBox>
        </HBox>

        <!-- Main Product List Area -->
        <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS" maxWidth="960">
            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
            
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox spacing="2">
                    <Label text="Danh mục sản phẩm đăng bán" styleClass="text-lg, font-bold, text-white"/>
                    <Label text="Quản lý sản phẩm, xóa hoặc hủy phiên đấu giá" styleClass="text-xs, text-body"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Đăng bán sản phẩm mới ➕" onAction="#goToAddItem" styleClass="btn-primary" style="-fx-min-height: 38px; -fx-padding: 8px 16px;"/>
                <Button text="Làm mới 🔄" onAction="#handleRefresh" styleClass="btn-secondary" style="-fx-min-height: 38px; -fx-padding: 8px 16px;"/>
            </HBox>

            <ListView fx:id="itemListView" styleClass="list-view" VBox.vgrow="ALWAYS"/>
            
            <HBox alignment="CENTER_RIGHT">
                <Label fx:id="statusLabel" styleClass="status-info, text-sm"/>
            </HBox>
        </VBox>

    </VBox>

</VBox>
