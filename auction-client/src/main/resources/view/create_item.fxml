<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.CreateItemController"
      prefHeight="768.0" prefWidth="1024.0"
      styleClass="canvas">

    <!-- Navbar -->
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="nav-bar">
        <Button text="← Quay lại dashboard" onAction="#goBack" styleClass="btn-secondary" style="-fx-min-height: 36px; -fx-padding: 6px 16px;"/>
        <Label text="Tạo Phiên Đấu Giá Mới" styleClass="text-lg, font-bold, text-white"/>
    </HBox>

    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <StackPane style="-fx-padding: 40 20 40 20;">
            <VBox spacing="25" styleClass="card-elevated" maxWidth="550" maxHeight="620" alignment="TOP_LEFT">
                <padding><Insets top="30" bottom="30" left="35" right="35"/></padding>
                
                <VBox spacing="4">
                    <Label text="Thông tin phiên đấu giá" styleClass="text-2xl, font-bold, text-white"/>
                    <Label text="Sản phẩm sẽ tự động được lên lịch đấu giá trực tiếp ngay sau khi tạo." styleClass="text-xs, text-body"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Tên sản phẩm" styleClass="text-sm, font-bold, text-body"/>
                    <TextField fx:id="nameField" promptText="VD: Đồng hồ Rolex Submariner" styleClass="input-field"/>
                </VBox>

                <HBox spacing="15">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Giá khởi điểm (VNĐ)" styleClass="text-sm, font-bold, text-body"/>
                        <TextField fx:id="priceField" promptText="VD: 5000000" styleClass="input-field"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Danh mục sản phẩm" styleClass="text-sm, font-bold, text-body"/>
                        <ComboBox fx:id="typeBox" promptText="Chọn loại danh mục" styleClass="combo-box" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="Mô tả chi tiết sản phẩm" styleClass="text-sm, font-bold, text-body"/>
                    <TextArea fx:id="descArea" promptText="Mô tả chi tiết tình trạng, xuất xứ sản phẩm..." prefRowCount="3" styleClass="text-area"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Thời gian diễn ra phiên đấu giá (Phút)" styleClass="text-sm, font-bold, text-body"/>
                    <TextField fx:id="durationField" promptText="VD: 60" styleClass="input-field"/>
                </VBox>

                <Button text="Tạo Phiên Đấu Giá 🚀" onAction="#handleCreateItem" styleClass="btn-primary" maxWidth="Infinity" style="-fx-min-height: 48px;"/>

                <Label fx:id="statusLabel" styleClass="text-sm" wrapText="true" alignment="CENTER" maxWidth="Infinity"/>
            </VBox>
        </StackPane>
    </ScrollPane>

</VBox>
