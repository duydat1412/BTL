<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.AuctionListController"
      prefHeight="768.0" prefWidth="1024.0"
      styleClass="canvas">

    <!-- Navbar -->
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="nav-bar">
        <Label text="🏛 DHDH AUCTION" styleClass="text-lg, font-bold, text-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="userInfoLabel" styleClass="text-sm, text-body"/>
        <Label fx:id="balanceLabel" styleClass="text-sm, font-mono, text-white" style="-fx-font-weight: bold;"/>
        <Button text="Nạp tiền 💰" onAction="#handleTopUp" styleClass="btn-secondary" style="-fx-min-height: 36px; -fx-padding: 6px 16px;"/>
        <Button text="Đăng xuất 🚪" onAction="#handleLogout" styleClass="btn-secondary" style="-fx-min-height: 36px; -fx-padding: 6px 16px;"/>
    </HBox>

    <!-- Main Workspace Container -->
    <VBox spacing="20" alignment="TOP_CENTER" VBox.vgrow="ALWAYS" styleClass="section">
        <padding><Insets top="20" bottom="20" left="30" right="30"/></padding>

        <!-- Hero / Stats Summary Card -->
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="card-dark" maxWidth="960" prefHeight="100" minHeight="100">
            <padding><Insets top="15" bottom="15" left="25" right="25"/></padding>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Đấu giá trực tuyến chuyên nghiệp" styleClass="text-white, text-2xl, font-bold"/>
                <Label text="Khám phá các phiên đấu giá đang diễn ra và đặt giá cho sản phẩm bạn yêu thích." styleClass="text-body, text-sm"/>
            </VBox>
            <Button text="Tải lại danh sách 🔄" onAction="#handleRefresh" styleClass="btn-secondary" style="-fx-min-height: 38px; -fx-padding: 8px 16px;"/>
        </HBox>

        <!-- List & Tab Pane Area -->
        <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS" maxWidth="960">
            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
            <TabPane VBox.vgrow="ALWAYS" styleClass="tab-pane">
                <Tab text="🔥 Phiên đang chạy" closable="false">
                    <VBox spacing="10" VBox.vgrow="ALWAYS">
                        <padding><Insets top="15" bottom="5" left="5" right="5"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Danh sách các phiên đấu giá nổi bật" styleClass="text-lg, font-bold, text-white"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="statusLabel" styleClass="status-info, text-sm"/>
                        </HBox>
                        <ListView fx:id="listView" styleClass="list-view" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </Tab>
                <Tab text="🏆 Phiên đã thắng" closable="false">
                    <VBox spacing="10" VBox.vgrow="ALWAYS">
                        <padding><Insets top="15" bottom="5" left="5" right="5"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Sản phẩm bạn đã thắng đấu giá thành công" styleClass="text-lg, font-bold, text-white"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="wonStatusLabel" styleClass="status-success, text-sm"/>
                        </HBox>
                        <ListView fx:id="wonListView" styleClass="list-view" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>

    </VBox>

</VBox>
